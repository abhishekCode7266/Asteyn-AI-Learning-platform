{
  "entities": {
    "User": {
      "title": "User",
      "description": "A user profile in the app",
      "type": "object",
      "properties": {
        "name": { "type": "string", "maxLength": 100 },
        "email": { "type": "string", "maxLength": 100 },
        "role": { "type": "string", "enum": ["student", "teacher"] },
        "hasPaid": { "type": "boolean" }
      },
      "required": ["name", "email", "role", "hasPaid"]
    },
    "BookReview": {
      "title": "BookReview",
      "description": "A student rating and review for a library book",
      "type": "object",
      "properties": {
        "bookId": { "type": "string" },
        "bookTitle": { "type": "string" },
        "userId": { "type": "string" },
        "userName": { "type": "string" },
        "userRole": { "type": "string" },
        "rating": { "type": "number", "minimum": 1, "maximum": 5 },
        "reviewText": { "type": "string" },
        "tags": { "type": "array", "items": { "type": "string" } },
        "createdAt": { "type": "string" },
        "verifiedReader": { "type": "boolean" }
      },
      "required": ["bookId", "userId", "userName", "rating", "reviewText"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/User" },
      "description": "Stores user profiles."
    },
    "/book_reviews/{reviewId}": {
      "schema": { "$ref": "#/entities/BookReview" },
      "description": "Stores student ratings and reviews for library books."
    }
  }
}
